# ---------------------------------------------------------------------------
# Copie este arquivo para ".env" e preencha os valores.
# Nunca envie o ".env" para o GitHub — ele contém senhas.
# ---------------------------------------------------------------------------

# Claude API — https://console.anthropic.com  → API Keys
# Se deixar em branco, o app roda em MODO DEMONSTRAÇÃO: entrega textos de exemplo
# em vez de chamar a IA, e todo o resto (artes, fotos, banco) funciona normalmente.
ANTHROPIC_API_KEY=

# Deixe em 1 para forçar o modo demonstração mesmo com a chave preenchida.
MODO_DEMONSTRACAO=

# Banco de dados PostgreSQL do Supabase
# Supabase → Project Settings → Database → Connection string → URI (modo "Session")
# Troque [YOUR-PASSWORD] pela senha do banco que você definiu ao criar o projeto.
DATABASE_URL=

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave secreta (service_role). Só é usada no servidor, nunca vai para o navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Banco de imagens — https://www.pexels.com/api/ (gratuito, liberado na hora)
PEXELS_API_KEY=

# Nome do bucket do Supabase Storage onde ficam logos e fotos do usuário
SUPABASE_STORAGE_BUCKET=uploads
