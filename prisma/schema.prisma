// Modelagem do MVP. Nomes de tabela/coluna em português (snake_case) para bater
// com a especificação do projeto; os nomes no código TypeScript ficam em camelCase.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// No Prisma 7 a URL de conexão não fica mais aqui — ela vive no prisma.config.ts
// (para os comandos de migração) e no adapter do PrismaClient (para a aplicação).
datasource db {
  provider = "postgresql"
}

enum Plataforma {
  INSTAGRAM
  YOUTUBE
  TIKTOK
  LINKEDIN
}

enum TipoConteudo {
  PUBLICACAO // legenda de post (Instagram, LinkedIn)
  ROTEIRO_VIDEO // script de vídeo (YouTube, TikTok)
}

enum StatusIdeia {
  SUGERIDO
  FAVORITO
  DESCARTADO
  PERSONALIZADO // tema digitado pelo próprio usuário
}

enum FormatoArte {
  POST // 4:5  — Instagram / LinkedIn
  THUMBNAIL // 16:9 — YouTube
  CAPA_VERTICAL // 9:16 — TikTok
}

/// Os 12 arquétipos de marca de Mark & Pearson (*The Hero and the Outlaw*),
/// agrupados em 4 motivações. O quiz do onboarding descobre primeiro a
/// motivação e depois o arquétipo dentro dela — por isso a ordem aqui segue
/// os grupos, e não o alfabeto.
enum Arquetipo {
  // Independência
  INOCENTE
  EXPLORADOR
  SABIO
  // Domínio
  HEROI
  FORA_DA_LEI
  MAGO
  // Pertencimento
  CARA_COMUM
  BOBO_DA_CORTE
  AMANTE
  // Estabilidade
  CUIDADOR
  GOVERNANTE
  CRIADOR
}

/// Gatilho mental usado na abertura e no CTA do conteúdo.
/// Cada arquétipo tem um gatilho "natural" (ver ARQUETIPOS em src/lib/arquetipos.ts),
/// mas o usuário pode sobrescrever — daí o campo existir separado do arquétipo.
enum GatilhoMental {
  NOVIDADE
  CURIOSIDADE
  AUTORIDADE
  DESAFIO
  EXCLUSIVIDADE
  ANTECIPACAO
  PROVA_SOCIAL
  RECIPROCIDADE
}

/// Espelho local do usuário do Supabase Auth.
/// O `id` é o mesmo uuid de `auth.users` — a senha nunca passa por aqui,
/// quem cuida disso é o Supabase.
model User {
  id                  String   @id @db.Uuid
  email               String   @unique
  nome                String?
  onboardingConcluido Boolean  @default(false) @map("onboarding_concluido")
  /// Só existe um ADMIN_MASTER, criado por seed a partir de ADMIN_MASTER_EMAIL.
  /// Não há tela pública para virar admin.
  papel               PapelUsuario @default(USER)
  /// Nulo = ativo. Preenchido = suspenso pelo admin, com a data.
  suspensoEm          DateTime?    @map("suspenso_em")
  /// Cliente correspondente no Asaas. Criado na primeira cobrança.
  asaasClienteId      String?      @unique @map("asaas_cliente_id")
  criadoEm            DateTime @default(now()) @map("criado_em")

  brandKit            BrandKit?
  niches              Niche[]
  platformPreferences PlatformPreference[]
  generatedArtes      GeneratedArte[]
  subscription        Subscription?
  creditBalance       CreditBalance?
  creditTransactions  CreditTransaction[]
  payments            Payment[]
  acoesDeAdmin        AdminAuditLog[]

  @@map("users")
}

model BrandKit {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @unique @map("user_id") @db.Uuid
  nomeMarca      String   @map("nome_marca")
  logoUrl        String?  @map("logo_url")
  corPrimaria    String   @map("cor_primaria") // hex, ex: "#1F5A4A"
  corSecundaria  String?  @map("cor_secundaria")
  coresExtraidas String[] @map("cores_extraidas") // paleta lida do logo via Canvas
  fonte          String   @default("Inter")

  // Anuláveis de propósito: as contas criadas antes do quiz existir continuam
  // válidas e a interface convida essas pessoas a responder quando entrarem.
  arquetipo        Arquetipo?     @map("arquetipo")
  // Derivado do arquétipo no momento do quiz, mas guardado separado porque o
  // usuário pode trocar o gatilho sem trocar o arquétipo.
  gatilhoPreferido GatilhoMental? @map("gatilho_preferido")

  atualizadoEm   DateTime @updatedAt @map("atualizado_em")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("brand_kits")
}

model Niche {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  nome      String
  descricao String?
  criadoEm  DateTime @default(now()) @map("criado_em")

  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  researches NicheResearch[]
  ideas     ContentIdea[]

  @@index([userId])
  @@map("niches")
}

/// Cache das pesquisas feitas com a tool `web_search` da Claude API.
/// Evita repetir (e pagar) a mesma pesquisa toda vez que o usuário abre o painel.
model NicheResearch {
  id         String   @id @default(uuid()) @db.Uuid
  nicheId    String   @map("niche_id") @db.Uuid
  termo      String? // nulo = pesquisa geral do nicho; preenchido = tema específico
  resumo     String   @db.Text
  fontes     Json     @default("[]") // [{ titulo, url }]
  coletadoEm DateTime @default(now()) @map("coletado_em")

  niche Niche @relation(fields: [nicheId], references: [id], onDelete: Cascade)

  @@index([nicheId, coletadoEm])
  @@map("niche_research")
}

model PlatformPreference {
  id               String     @id @default(uuid()) @db.Uuid
  userId           String     @map("user_id") @db.Uuid
  plataforma       Plataforma
  formatoPreferido String?    @map("formato_preferido")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, plataforma])
  @@map("platform_preferences")
}

model ContentIdea {
  id            String      @id @default(uuid()) @db.Uuid
  nicheId       String      @map("niche_id") @db.Uuid
  titulo        String
  justificativa String?     @db.Text
  status        StatusIdeia @default(SUGERIDO)
  criadoEm      DateTime    @default(now()) @map("criado_em")

  niche   Niche    @relation(fields: [nicheId], references: [id], onDelete: Cascade)
  scripts Script[]

  @@index([nicheId, status])
  @@map("content_ideas")
}

/// Um registro por plataforma, todos ligados ao mesmo tema (ContentIdea).
/// É isso que garante que o conteúdo de uma plataforma não vaze para outra.
model Script {
  id              String       @id @default(uuid()) @db.Uuid
  ideaId          String       @map("idea_id") @db.Uuid
  plataforma      Plataforma
  tipo            TipoConteudo
  conteudo        String       @db.Text
  // Em segundos para cobrir TikTok (15/30/60s) e YouTube (60/180/300/600s).
  // Nulo quando o conteúdo é uma legenda de post.
  duracaoSegundos Int?         @map("duracao_segundos")
  // Registrado no momento da geração: se o usuário trocar de arquétipo depois,
  // o selo do roteiro antigo continua contando a verdade sobre como ele nasceu.
  gatilhoUsado    GatilhoMental? @map("gatilho_usado")
  arquetipoUsado  Arquetipo?     @map("arquetipo_usado")
  versao          Int          @default(1)
  editadoPeloUsuario Boolean   @default(false) @map("editado_pelo_usuario")
  criadoEm        DateTime     @default(now()) @map("criado_em")
  atualizadoEm    DateTime     @updatedAt @map("atualizado_em")

  idea ContentIdea    @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  arte GeneratedArte?
  seo  SeoMetadata?

  @@unique([ideaId, plataforma])
  @@map("scripts")
}

model GeneratedArte {
  id           String      @id @default(uuid()) @db.Uuid
  userId       String      @map("user_id") @db.Uuid
  scriptId     String      @unique @map("script_id") @db.Uuid
  plataforma   Plataforma
  formato      FormatoArte
  templateSvg  String      @db.Text @map("template_svg")
  /// Frase estampada na arte — curta, diferente do título do SEO.
  textoArte    String?     @map("texto_arte")
  /// "solido" (cor da marca) ou "foto" (banco de imagens / foto própria).
  fundo        String      @default("solido")
  /// Palavras-chave sugeridas pela IA para buscar a foto de fundo.
  termoFoto    String?     @map("termo_foto")
  fotoFundoUrl String?     @map("foto_fundo_url")
  fotoCredito  String?     @map("foto_credito") // atribuição do Pexels
  // Não existe coluna para o PNG final: a conversão acontece no navegador, na
  // hora do download (SVG → canvas → arquivo). Nada é gravado no servidor.
  criadoEm     DateTime    @default(now()) @map("criado_em")
  atualizadoEm DateTime    @updatedAt @map("atualizado_em")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  script Script @relation(fields: [scriptId], references: [id], onDelete: Cascade)

  @@map("generated_artes")
}

model SeoMetadata {
  id              String     @id @default(uuid()) @db.Uuid
  scriptId        String     @unique @map("script_id") @db.Uuid
  plataforma      Plataforma
  titulo          String
  descricao       String     @db.Text
  tagsOuHashtags  String[]   @map("tags_ou_hashtags")
  criadoEm        DateTime   @default(now()) @map("criado_em")
  atualizadoEm    DateTime   @updatedAt @map("atualizado_em")

  script Script @relation(fields: [scriptId], references: [id], onDelete: Cascade)

  @@map("seo_metadata")
}

/// Os três módulos comerciais. O catálogo (preço, cota, recursos) vive em
/// src/lib/planos.ts — aqui guardamos só qual deles o usuário assinou.
/// Papel do usuário. Só existem dois: cliente e dono da plataforma.
/// Papéis intermediários ficam fora de propósito — nada hoje precisa deles, e
/// permissão granular é fácil de adicionar e cara de remover.
enum PapelUsuario {
  USER
  ADMIN_MASTER
}

enum StatusPagamento {
  PAGO
  PENDENTE
  FALHOU
  REEMBOLSADO
}

/// Catálogo comercial. Virou tabela quando o painel admin passou a existir:
/// antes morava em src/lib/planos.ts, porque sem tela de administração mudar
/// preço pelo banco significava SQL na mão. Com o admin, o dono cria e arquiva
/// planos sozinho e a landing acompanha — o que exige o banco.
model Plan {
  id   String @id @default(uuid()) @db.Uuid
  /// Usado na URL (/cadastro?plano=criador). Estável mesmo se o nome mudar.
  slug String @unique
  nome String
  /// A frase de vitrine na landing.
  descricao String

  /// Em centavos. Dinheiro nunca em float.
  precoCentavos       Int @map("preco_centavos")
  creditosMensais     Int @map("creditos_mensais")
  minutosVideoMensais Int @default(0) @map("minutos_video_mensais")
  /// 0 significa ilimitadas.
  maxPlataformas      Int @map("max_plataformas")

  temTeleprompter Boolean @default(false) @map("tem_teleprompter")
  temBancoImagens Boolean @default(false) @map("tem_banco_imagens")
  temVideo        Boolean @default(false) @map("tem_video")

  /// Arquivado (false) some da landing e de novos cadastros, mas continua
  /// valendo para quem já assina. Plano com usuário nunca é excluído.
  ativo         Boolean @default(true)
  ordemExibicao Int     @default(0) @map("ordem_exibicao")
  /// O card com a borda ciano na landing.
  destaque      Boolean @default(false)

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  subscriptions Subscription[]

  @@index([ativo, ordemExibicao])
  @@map("plans")
}

/// Pacotes avulsos de crédito. Mesma lógica do Plan: catálogo editável.
model CreditPack {
  id            String  @id @default(uuid()) @db.Uuid
  slug          String  @unique
  nome          String
  /// Créditos, ou minutos de vídeo quando `tipo` é MINUTO_VIDEO.
  quantidade    Int
  precoCentavos Int     @map("preco_centavos")
  tipo          String  @default("credito") // "credito" | "minuto_video"
  ativo         Boolean @default(true)
  ordemExibicao Int     @default(0) @map("ordem_exibicao")

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@map("credit_packs")
}

/// Configuração da plataforma, com vigência.
///
/// Guardar `vigenteDesde` em vez de sobrescrever é o que permite recalcular
/// custo de um consumo antigo com o preço que valia naquele dia. Sem isso,
/// mudar o custo por crédito reescreveria o histórico financeiro inteiro.
model PlatformSetting {
  id           String   @id @default(uuid()) @db.Uuid
  chave        String
  valorJson    Json     @map("valor_json")
  vigenteDesde DateTime @default(now()) @map("vigente_desde")
  criadoEm     DateTime @default(now()) @map("criado_em")

  @@unique([chave, vigenteDesde])
  @@index([chave, vigenteDesde])
  @@map("platform_settings")
}

/// Toda escrita do admin, com o estado antes e depois. Sem exceção.
model AdminAuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  adminId   String   @map("admin_id") @db.Uuid
  acao      String
  alvoTipo  String   @map("alvo_tipo")
  alvoId    String?  @map("alvo_id")
  antesJson Json?    @map("antes_json")
  depoisJson Json?   @map("depois_json")
  criadoEm  DateTime @default(now()) @map("criado_em")

  admin User @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([criadoEm])
  @@map("admin_audit_log")
}

/// Receita. Alimentada SÓ por webhook do Stripe — nunca por clique ou front.
model Payment {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  /// Único: reprocessar o mesmo evento não pode duplicar pagamento nem crédito.
  asaasEventoId String @unique @map("asaas_evento_id")
  /// Id da COBRANÇA. Dois eventos diferentes (CONFIRMED e RECEIVED) falam da
  /// mesma cobrança — sem este campo, ela entraria duas vezes na receita.
  asaasCobrancaId String? @map("asaas_cobranca_id")
  tipo          String
  descricao     String
  /// Negativo em reembolso.
  valorCentavos Int             @map("valor_centavos")
  moeda         String          @default("BRL")
  status        StatusPagamento
  criadoEm      DateTime        @default(now()) @map("criado_em")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([criadoEm, status])
  @@map("payments")
}

enum StatusAssinatura {
  ATIVA
  CANCELADA
  INADIMPLENTE
}

enum TipoTransacao {
  CONSUMO
  RESET_MENSAL
  COMPRA_AVULSA
  /// Crédito dado ou retirado à mão pelo admin. Sempre com motivo.
  AJUSTE_ADMIN
}

/// Qual assinatura o usuário tem hoje.
model Subscription {
  id          String           @id @default(uuid()) @db.Uuid
  userId      String           @unique @map("user_id") @db.Uuid
  planId      String           @map("plan_id") @db.Uuid
  status      StatusAssinatura @default(ATIVA)
  /// Cortesia não entra no MRR: é acesso dado, não receita.
  cortesia    Boolean          @default(false)
  inicioCiclo DateTime         @default(now()) @map("inicio_ciclo")
  /// Quando o saldo do plano volta ao valor cheio. Lido em toda leitura de
  /// conta: é assim que o reset acontece sem depender de um cron externo.
  proximoReset DateTime        @map("proximo_reset")

  /// Downgrade vale só no próximo ciclo, para não tirar crédito já pago.
  /// Até lá o plano novo fica esperando aqui.
  planoPendenteId      String? @map("plano_pendente_id") @db.Uuid
  asaasAssinaturaId    String? @map("asaas_assinatura_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan @relation(fields: [planId], references: [id])

  @@index([planId, status])
  @@map("user_subscriptions")
}

/// Saldo corrente. Fonte da verdade para "pode gerar?".
///
/// O histórico completo fica em CreditTransaction; esta tabela é só o número
/// que interessa na hora de decidir, para não somar o ledger inteiro a cada
/// clique.
model CreditBalance {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @unique @map("user_id") @db.Uuid
  /// Créditos do plano do mês. Zeram na virada do ciclo.
  saldoPlano   Int      @default(0) @map("saldo_plano")
  /// Créditos comprados avulso. NÃO zeram na virada.
  saldoAvulso  Int      @default(0) @map("saldo_avulso")
  minutosVideo Int      @default(0) @map("minutos_video")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("credit_balances")
}

/// Ledger: todo movimento de crédito, para sempre.
///
/// Saldo é derivável daqui, mas o contrário não — por isso as duas tabelas
/// existem. Quando um saldo parecer errado, é esta lista que conta o porquê.
model CreditTransaction {
  id            String        @id @default(uuid()) @db.Uuid
  userId        String        @map("user_id") @db.Uuid
  tipo          TipoTransacao
  /// True quando o movimento saiu (ou entrou) no saldo avulso.
  origemAvulso  Boolean       @default(false) @map("origem_avulso")
  /// Positivo em entrada, negativo em consumo.
  quantidade    Int
  /// Legível por gente: "Roteiro — Instagram: 5 erros que contadores cometem".
  motivo        String
  /// Preenchido só em AJUSTE_ADMIN: quem mexeu no saldo à mão.
  criadoPorAdminId String?   @map("criado_por_admin_id") @db.Uuid
  criadoEm      DateTime      @default(now()) @map("criado_em")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, criadoEm])
  @@index([criadoEm, tipo])
  @@map("credit_transactions")
}
